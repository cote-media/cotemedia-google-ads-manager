{
  "name": "cotemedia-ads-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "guard": "node scripts/run-guards.mjs",
    "build": "npm run guard && next build",
    "start": "next start",
    "lint": "next lint",
    "mcp": "node mcp-server.js",
    "check:data": "node scripts/check-capture-landing.mjs --invariant-only --guard; A=$?; node scripts/check-frozen-cursors.mjs --guard; B=$?; node tests/guards/canonical-client-identity.guard.mjs --db; C=$?; node scripts/breakdown-reachability-check.mjs --gate; D=$?; node scripts/check-completion-claims.mjs --guard; E=$?; node scripts/check-doc-ownership-data.mjs; F=$?; node scripts/check-drain-throttle.mjs --guard; G=$?; node scripts/check-parent-analyze.mjs --gate; H=$?; node tests/guards/google-op-budget.guard.mjs --db; I=$?; W=$A; for v in $B $C $D $E $F $G $H $I; do [ $v -gt $W ] && W=$v; done; exit $W",
    "prepush": "npm run build && npm run check:data",
    "evals": "node tests/lora-evals/run-evals.mjs",
    "stripe:sync": "node scripts/stripe-sync-products.mjs",
    "wrap": "node scripts/wrap-docs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/react-grid-layout": "^1.3.6",
    "@vercel/functions": "^3.7.4",
    "@vercel/queue": "^0.4.0",
    "bcryptjs": "^3.0.3",
    "file-type": "^21.3.4",
    "google-ads-api": "^23.0.0",
    "googleapis": "^144.0.0",
    "mammoth": "^1.12.0",
    "next": "14.2.3",
    "next-auth": "^4.24.7",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "react-grid-layout": "^1.5.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "stripe": "^22.2.0",
    "unpdf": "^1.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "pg": "^8.22.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
